# ChallengeChain environment configuration
# Copy this file to .env and adjust the values.

APP_NAME=ChallengeChain
APP_ENV=local
APP_DEBUG=true
# Public base URL (no trailing slash) — used for share links & Open Graph tags
APP_URL=http://localhost:8000

# SQLite database location (outside the public web directory)
DB_PATH=storage/database.sqlite

SESSION_NAME=challengechain_session
SESSION_LIFETIME=604800

# --- OpenRouter free models (OpenAI-compatible REST API) ---
# Leave AI_API_KEY empty to run in DEMO MODE (clearly labelled, predefined challenges).
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
# This router selects free models only; no paid fallback is configured.
AI_MODEL=openrouter/free
AI_TIMEOUT=45

# --- Rate limiting ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
AI_MAX_PER_HOUR=6

# --- Email (optional, for password reset) ---
# When MAIL_ENABLED=false the reset link is only shown in debug mode.
MAIL_ENABLED=false
MAIL_FROM=no-reply@challengechain.local
MAIL_FROM_NAME=ChallengeChain
